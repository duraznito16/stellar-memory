{
  "name": "soroban-memory",
  "version": "0.1.0",
  "description": "Persistent memory layer for Stellar/Soroban projects. Scans your repo, links code to on-chain reality, and serves the result to you and to your AI agents over MCP.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stellar-memory": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "files": [
    "dist",
    "templates",
    "scripts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duraznito16/stellar-memory.git"
  },
  "homepage": "https://github.com/duraznito16/stellar-memory#readme",
  "bugs": {
    "url": "https://github.com/duraznito16/stellar-memory/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "stellar-cli-plugin",
    "mcp",
    "mcp-server",
    "knowledge-graph",
    "developer-tools",
    "smart-contracts",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build",
    "_comment_test": "Tests are TypeScript run through Node's native type stripping, which needs Node 22.6+. What ships is compiled JavaScript and runs on Node 20.",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp:call": "node scripts/mcp-call.mjs",
    "memory": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
