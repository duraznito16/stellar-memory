# Normalise to LF in the repository. This package is developed on Windows but
# runs everywhere, and a shell script checked in with CRLF fails on Linux and
# macOS with a confusing "bad interpreter" error.
* text=auto eol=lf

*.sh text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf

*.wasm binary
